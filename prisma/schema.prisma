// YWBC backend — Prisma schema
// Single source of truth for the YWBC database.
// Run `npx prisma migrate dev --name <name>` after changes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────── USERS ───────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  phone         String?
  photoURL      String?
  language      Language @default(EN)
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  surveyAnswers Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings                  Booking[]
  conversationRegistrations ConversationRegistration[]
  moodEntries               MoodEntry[]
  passwordResets            PasswordReset[]
  emailVerifications        EmailVerification[]
  emailChangeRequests       EmailChangeRequest[]
  chatConversations         ChatConversation[]
}

enum Role {
  USER
  ADMIN
}

enum Language {
  EN
  RW
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([code])
}

/// One-shot record for the change-email flow. The 6-digit code is emailed to
/// the user's CURRENT address (so a stolen new-email can't hijack the
/// account). When consumed, the user's `email` is swapped to `newEmail`.
model EmailChangeRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([code])
}

// ─────────── PSYCHOLOGISTS ───────────
model Psychologist {
  id                 String        @id @default(cuid())
  fullName           String
  title              String
  photoURL           String
  bio                String
  specialties        String[]
  languages          String[]
  credentials        String[]
  /// Contact + payout details added in the revamp. Email is optional so
  /// historical records keep loading; new profiles populate it.
  email              String?
  phone              String?
  momoNumber         String?
  momoAccountName    String?
  pricePerSession    Int
  pricingByType      Json
  sessionTypes       SessionType[]
  weeklySchedule     Json
  scheduleExceptions Json
  rating             Float         @default(0)
  reviewCount        Int           @default(0)
  yearsExperience    Int           @default(0)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  bookings Booking[]
  slots    Slot[]
}

enum SessionType {
  ONLINE
  IN_PERSON
  GROUP
}

model Slot {
  id             String       @id @default(cuid())
  psychologistId String
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  startTime      DateTime
  endTime        DateTime
  isBooked       Boolean      @default(false)

  @@index([psychologistId, startTime])
}

// ─────────── BOOKINGS ───────────
model Booking {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  psychologistId     String
  psychologist       Psychologist  @relation(fields: [psychologistId], references: [id])
  slotDateTime       DateTime
  sessionType        SessionType
  amount             Int
  status             BookingStatus @default(PENDING_PAYMENT)
  paymentProofURL    String?
  transactionId      String?
  adminNotes         String?
  rejectionReason    String?
  meetingLink        String?
  createdAt          DateTime      @default(now())
  paymentSubmittedAt DateTime?
  confirmedAt        DateTime?
  rejectedAt         DateTime?

  @@index([userId])
  @@index([status])
  @@index([psychologistId])
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
}

// ─────────── ONLINE CONVERSATIONS ───────────
model OnlineConversation {
  id            String             @id @default(cuid())
  title         String
  description   String
  coverImageURL String
  hostName      String
  hostPhotoURL  String
  /// Existing free-text topic line (also doubles as host title today).
  topic         String
  /// "Topic areas" classification (Trauma & Healing, Stress…). A session can
  /// span multiple topics, so this is an array. Empty by default to keep
  /// older rows valid until the admin re-edits them.
  topicAreas    String[]      @default([])
  /// New session "kind" — circle / workshop / support / training /
  /// conversation. Optional until older rows are migrated.
  gatheringType GatheringType?
  /// Optional in-person location fields.
  locationName  String?
  address       String?
  /// Languages the gathering will be held in. A session can be bilingual
  /// (e.g. Kinyarwanda + English), so this is an array. Empty by default.
  languages     String[]      @default([])
  /// Co-hosts (names) and prep items shown on the detail page.
  coHosts       String[]           @default([])
  prepItems     String[]           @default([])
  /// Free-text accessibility notes for the detail page.
  accessibilityNotes String?
  dateTime      DateTime
  /// Optional end date for multi-day gatherings (e.g. a 3-day workshop).
  /// Null for single-day sessions — most sessions don't span days.
  endsAt        DateTime?
  duration      Int
  capacity      Int
  isFree        Boolean            @default(true)
  price         Int?
  meetingLink   String?
  status        ConversationStatus @default(DRAFT)
  isRecurring   Boolean            @default(false)
  recurrence    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  registrations ConversationRegistration[]
  broadcasts    SessionBroadcast[]
}

enum GatheringType {
  CIRCLE
  WORKSHOP
  SUPPORT
  TRAINING
  CONVERSATION
}

enum ConversationStatus {
  DRAFT
  UPCOMING
  LIVE
  PAST
  CANCELLED
}

model ConversationRegistration {
  id             String             @id @default(cuid())
  conversationId String
  conversation   OnlineConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  reason         String?
  attended       Boolean            @default(false)
  registeredAt   DateTime           @default(now())

  @@unique([conversationId, userId])
}

model SessionBroadcast {
  id             String             @id @default(cuid())
  conversationId String
  conversation   OnlineConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  subject        String
  body           String
  recipientCount Int
  sentAt         DateTime           @default(now())
}

// ─────────── ARTICLES ───────────
model Article {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  excerpt       String
  content       String
  coverImageURL String
  author        String
  category      String
  tags          String[]
  readingTime   Int
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  scheduledFor  DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

// ─────────── DAILY QUOTES ───────────
model DailyQuote {
  id           String        @id @default(cuid())
  text         String
  author       String        @default("Dr. Brave Olivier")
  category     QuoteCategory
  isActive     Boolean       @default(true)
  scheduledFor DateTime?
  createdAt    DateTime      @default(now())
}

enum QuoteCategory {
  WELLNESS
  NUTRITION
  MOTIVATION
  RECONCILIATION
}

// ─────────── FAQs (Chatbot Knowledge) ───────────
model FAQ {
  id              String      @id @default(cuid())
  question        String
  answer          String
  /// Kinyarwanda translations — populated by the founder so Ubuzima can
  /// answer in the language the user wrote in.
  questionRw      String?
  answerRw        String?
  category        FAQCategory
  followUpActions Json?
  relatedFaqIds   String[]
  order           Int         @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([category, order])
}

enum FAQCategory {
  GENERAL
  THERAPY
  NUTRITION
  BOOKING
}

// ─────────── MEDITATIONS ───────────
model Meditation {
  id            String             @id @default(cuid())
  title         String
  description   String
  // Audio + cover are required to PUBLISH but allowed empty on draft so the
  // admin can save partial work as they upload. The publish path checks both.
  audioURL      String             @default("")
  duration      Int                @default(0)
  coverImageURL String             @default("")
  /// Narrator name shown to listeners (e.g. "Dr. Brave Olivier"). Optional.
  narrator      String?
  /// Full transcript (markdown allowed) for accessibility + search. Optional.
  transcript    String?
  category      MeditationCategory
  status        ContentStatus      @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime           @default(now())
}

enum MeditationCategory {
  SLEEP
  ANXIETY
  FOCUS
  BREATHING
  BODY_SCAN
}

// ─────────── NUTRITION ───────────
model NutritionTip {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model MealPlan {
  id            String        @id @default(cuid())
  title         String
  coverImageURL String
  goal          String
  durationDays  Int
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())

  days MealPlanDay[]
}

model MealPlanDay {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayNumber  Int
  meals      Json

  @@unique([mealPlanId, dayNumber])
}

// ─────────── MOOD ENTRIES ───────────
model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      Int
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────── CHATBOT (Ubuzima) ───────────
model ChatConversation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Auto-derived from the first user message — keeps the list scannable.
  title         String?
  language      Language @default(EN)
  /// Flipped to true the moment any message triggers the crisis protocol.
  /// Admin reviews these proactively.
  hasCrisisFlag Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages      ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  /// What Ubuzima attached alongside the text — quote, meditation, therapist,
  /// session, faq ids. Mobile renders inline cards from these.
  enrichments    Json?
  /// Tappable buttons under the message (book_therapist / view_meditation / etc).
  quickActions   Json?
  language       Language
  /// Token cost of this turn (used for daily-quota guarding).
  tokensUsed     Int?
  isCrisis       Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AdminNotification {
  id        String    @id @default(cuid())
  type      String
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}
