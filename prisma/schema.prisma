// YWBC backend — Prisma schema
// Single source of truth for the YWBC database.
// Run `npx prisma migrate dev --name <name>` after changes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────── USERS ───────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  phone         String?
  photoURL      String?
  language      Language @default(EN)
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  surveyAnswers Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings                  Booking[]
  conversationRegistrations ConversationRegistration[]
  moodEntries               MoodEntry[]
  passwordResets            PasswordReset[]
  emailVerifications        EmailVerification[]
}

enum Role {
  USER
  ADMIN
}

enum Language {
  EN
  RW
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([code])
}

// ─────────── PSYCHOLOGISTS ───────────
model Psychologist {
  id                 String        @id @default(cuid())
  fullName           String
  title              String
  photoURL           String
  bio                String
  specialties        String[]
  languages          String[]
  credentials        String[]
  pricePerSession    Int
  pricingByType      Json
  sessionTypes       SessionType[]
  weeklySchedule     Json
  scheduleExceptions Json
  rating             Float         @default(0)
  reviewCount        Int           @default(0)
  yearsExperience    Int           @default(0)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  bookings Booking[]
  slots    Slot[]
}

enum SessionType {
  ONLINE
  IN_PERSON
  GROUP
}

model Slot {
  id             String       @id @default(cuid())
  psychologistId String
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  startTime      DateTime
  endTime        DateTime
  isBooked       Boolean      @default(false)

  @@index([psychologistId, startTime])
}

// ─────────── BOOKINGS ───────────
model Booking {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  psychologistId     String
  psychologist       Psychologist  @relation(fields: [psychologistId], references: [id])
  slotDateTime       DateTime
  sessionType        SessionType
  amount             Int
  status             BookingStatus @default(PENDING_PAYMENT)
  paymentProofURL    String?
  transactionId      String?
  adminNotes         String?
  rejectionReason    String?
  meetingLink        String?
  createdAt          DateTime      @default(now())
  paymentSubmittedAt DateTime?
  confirmedAt        DateTime?
  rejectedAt         DateTime?

  @@index([userId])
  @@index([status])
  @@index([psychologistId])
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
}

// ─────────── ONLINE CONVERSATIONS ───────────
model OnlineConversation {
  id            String             @id @default(cuid())
  title         String
  description   String
  coverImageURL String
  hostName      String
  hostPhotoURL  String
  topic         String
  dateTime      DateTime
  duration      Int
  capacity      Int
  isFree        Boolean            @default(true)
  price         Int?
  meetingLink   String?
  status        ConversationStatus @default(DRAFT)
  isRecurring   Boolean            @default(false)
  recurrence    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  registrations ConversationRegistration[]
  broadcasts    SessionBroadcast[]
}

enum ConversationStatus {
  DRAFT
  UPCOMING
  LIVE
  PAST
  CANCELLED
}

model ConversationRegistration {
  id             String             @id @default(cuid())
  conversationId String
  conversation   OnlineConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  reason         String?
  attended       Boolean            @default(false)
  registeredAt   DateTime           @default(now())

  @@unique([conversationId, userId])
}

model SessionBroadcast {
  id             String             @id @default(cuid())
  conversationId String
  conversation   OnlineConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  subject        String
  body           String
  recipientCount Int
  sentAt         DateTime           @default(now())
}

// ─────────── ARTICLES ───────────
model Article {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  excerpt       String
  content       String
  coverImageURL String
  author        String
  category      String
  tags          String[]
  readingTime   Int
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  scheduledFor  DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

// ─────────── DAILY QUOTES ───────────
model DailyQuote {
  id           String        @id @default(cuid())
  text         String
  author       String        @default("Dr. Brave Olivier")
  category     QuoteCategory
  isActive     Boolean       @default(true)
  scheduledFor DateTime?
  createdAt    DateTime      @default(now())
}

enum QuoteCategory {
  WELLNESS
  NUTRITION
  MOTIVATION
  RECONCILIATION
}

// ─────────── FAQs (Chatbot Knowledge) ───────────
model FAQ {
  id              String      @id @default(cuid())
  question        String
  answer          String
  category        FAQCategory
  followUpActions Json?
  relatedFaqIds   String[]
  order           Int         @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([category, order])
}

enum FAQCategory {
  GENERAL
  THERAPY
  NUTRITION
  BOOKING
}

// ─────────── MEDITATIONS ───────────
model Meditation {
  id            String             @id @default(cuid())
  title         String
  description   String
  audioURL      String
  duration      Int
  coverImageURL String
  category      MeditationCategory
  status        ContentStatus      @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime           @default(now())
}

enum MeditationCategory {
  SLEEP
  ANXIETY
  FOCUS
  BREATHING
  BODY_SCAN
}

// ─────────── NUTRITION ───────────
model NutritionTip {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model MealPlan {
  id            String        @id @default(cuid())
  title         String
  coverImageURL String
  goal          String
  durationDays  Int
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())

  days MealPlanDay[]
}

model MealPlanDay {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayNumber  Int
  meals      Json

  @@unique([mealPlanId, dayNumber])
}

// ─────────── MOOD ENTRIES ───────────
model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      Int
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
