# YWBC backend env (copy to .env, fill in real values)

DATABASE_URL=postgresql://postgres:password@localhost:5432/ywbc
JWT_SECRET=replace-with-a-32+-char-random-string
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# CORS (comma-separated origins; * accepted in dev)
CORS_ORIGIN=http://localhost:8081

# Cloudinary (image + audio uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend) — optional in dev; password reset logs to console without it
RESEND_API_KEY=
EMAIL_FROM=YWBC <noreply@yourwellbeingcenter.rw>

# Anthropic (chatbot — installed but unused in v1; see Section 16 of the brief)
ANTHROPIC_API_KEY=
